{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ch32-riscv-ug/ch32-device-data/blob/main/schemas/device.schema.json",
  "title": "CH32 exact orderable device draft manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "identity",
    "cpu",
    "memory",
    "package",
    "peripherals",
    "pins",
    "sources",
    "coverage",
    "verification"
  ],
  "properties": {
    "schema_version": { "const": "0.1-draft" },
    "kind": { "const": "orderable-device" },
    "id": { "$ref": "#/$defs/id" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manufacturer", "part_number", "series"],
      "properties": {
        "manufacturer": { "const": "WCH" },
        "part_number": { "type": "string", "pattern": "^CH32[A-Z][0-9A-Z]+$" },
        "series": { "type": "string", "pattern": "^CH32[A-Z][0-9A-Z]+$" },
        "silicon_variant": { "type": "string", "minLength": 1 }
      }
    },
    "cpu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cores", "evidence"],
      "properties": {
        "cores": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "vendor_core", "isa_claim", "clock_profiles"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "vendor_core": { "type": "string", "minLength": 1 },
              "isa_claim": {
                "type": "string",
                "minLength": 1,
                "description": "Vendor document wording; not a compiler -march value."
              },
              "clock_profiles": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "frequency_hz"],
                  "properties": {
                    "name": { "$ref": "#/$defs/id" },
                    "frequency_hz": { "type": "integer", "minimum": 1 },
                    "conditions": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "role": { "type": "string", "enum": ["primary", "secondary", "performance", "control"] }
            }
          }
        },
        "evidence": { "$ref": "#/$defs/evidenceList" }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regions", "evidence"],
      "properties": {
        "regions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "size_bytes"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "kind": {
                "type": "string",
                "enum": ["code-flash", "data-flash", "sram", "itcm", "dtcm", "psram", "other"]
              },
              "size_bytes": { "type": "integer", "minimum": 1 },
              "attributes": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "subset_of": { "$ref": "#/$defs/id" },
              "notes": { "type": "string", "minLength": 1 }
            }
          }
        },
        "evidence": { "$ref": "#/$defs/evidenceList" }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "pin_count", "gpio_count", "evidence"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "pin_count": { "type": "integer", "minimum": 1 },
        "exposed_pad_count": { "type": "integer", "minimum": 0 },
        "gpio_count": { "type": "integer", "minimum": 0 },
        "body": { "type": "string", "minLength": 1 },
        "temperature_grade": { "type": "string", "minLength": 1 },
        "special_io_counts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "count"],
            "properties": {
              "kind": { "$ref": "#/$defs/id" },
              "count": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "evidence": { "$ref": "#/$defs/evidenceList" }
      }
    },
    "peripherals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "evidence"],
        "properties": {
          "kind": { "$ref": "#/$defs/id" },
          "instances": { "type": "integer", "minimum": 0 },
          "channels": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "count"],
              "properties": {
                "kind": { "$ref": "#/$defs/id" },
                "count": { "type": "integer", "minimum": 0 }
              }
            }
          },
          "features": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "notes": { "type": "string", "minLength": 1 },
          "evidence": { "$ref": "#/$defs/evidenceList" }
        }
      }
    },
    "route_selectors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "controller", "register", "field", "valid_values", "reset_value", "evidence"],
        "oneOf": [
          {
            "required": ["bit_offset", "bit_width"],
            "not": { "required": ["bit_positions"] }
          },
          {
            "required": ["bit_positions"],
            "not": {
              "anyOf": [
                { "required": ["bit_offset"] },
                { "required": ["bit_width"] }
              ]
            }
          }
        ],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "controller": { "$ref": "#/$defs/id" },
          "register": { "type": "string", "minLength": 1 },
          "field": { "type": "string", "minLength": 1 },
          "bit_offset": { "type": "integer", "minimum": 0 },
          "bit_width": { "type": "integer", "minimum": 1 },
          "bit_positions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "description": "Physical register bit positions in selector-value LSB-to-MSB order.",
            "items": { "type": "integer", "minimum": 0, "maximum": 31 }
          },
          "valid_values": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "integer", "minimum": 0 }
          },
          "reset_value": { "type": "integer", "minimum": 0 },
          "evidence": { "$ref": "#/$defs/evidenceList" }
        }
      }
    },
    "pins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "pad", "kind", "functions", "evidence"],
        "properties": {
          "number": {
            "oneOf": [
              { "type": "integer", "minimum": 1 },
              { "type": "string", "pattern": "^EP[0-9]*$" }
            ]
          },
          "pad": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["gpio", "power", "ground", "reset", "analog", "other"] },
          "functions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["signal"],
              "properties": {
                "signal": { "type": "string", "minLength": 1 },
                "peripheral": { "$ref": "#/$defs/id" },
                "route": { "type": "string", "minLength": 1 },
                "selection": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["selector", "values"],
                  "properties": {
                    "selector": { "$ref": "#/$defs/id" },
                    "values": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": { "type": "integer", "minimum": 0 }
                    }
                  }
                },
                "conditions": { "type": "string", "minLength": 1 }
              }
            }
          },
          "electrical_classes": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" }
          },
          "evidence": { "$ref": "#/$defs/evidenceList" }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "title", "language", "document_version", "url", "sha256", "hash_scope", "mirror"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "kind": { "type": "string", "enum": ["datasheet", "reference-manual", "evt", "errata", "other"] },
          "title": { "type": "string", "minLength": 1 },
          "language": { "type": "string", "enum": ["en", "zh"] },
          "document_version": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "hash_scope": { "type": "string", "enum": ["download-artifact", "source-file"] },
          "mirror": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repository", "commit", "path"],
            "properties": {
              "repository": { "type": "string", "format": "uri", "pattern": "^https://" },
              "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
              "path": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "integrated_components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "pads", "evidence"],
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "resistor" } }, "required": ["kind"] },
            "then": { "required": ["resistance_ohms"] }
          }
        ],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "kind": { "type": "string", "enum": ["resistor", "oscillator", "other"] },
          "pads": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "resistance_ohms": { "type": "number", "exclusiveMinimum": 0 },
          "control": { "type": "string", "enum": ["fixed", "software-controlled"] },
          "notes": { "type": "string", "minLength": 1 },
          "evidence": { "$ref": "#/$defs/evidenceList" }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "cpu", "memory", "package", "peripherals", "package_pins", "pin_functions"],
      "properties": {
        "identity": { "$ref": "#/$defs/coverageState" },
        "cpu": { "$ref": "#/$defs/coverageState" },
        "memory": { "$ref": "#/$defs/coverageState" },
        "package": { "$ref": "#/$defs/coverageState" },
        "peripherals": { "$ref": "#/$defs/coverageState" },
        "package_pins": { "$ref": "#/$defs/coverageState" },
        "pin_functions": { "$ref": "#/$defs/coverageState" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "cpu", "memory", "package", "peripherals", "package_pins", "pin_functions"],
      "properties": {
        "identity": { "$ref": "#/$defs/verificationState" },
        "cpu": { "$ref": "#/$defs/verificationState" },
        "memory": { "$ref": "#/$defs/verificationState" },
        "package": { "$ref": "#/$defs/verificationState" },
        "peripherals": { "$ref": "#/$defs/verificationState" },
        "package_pins": { "$ref": "#/$defs/verificationState" },
        "pin_functions": { "$ref": "#/$defs/verificationState" }
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "coverageState": { "type": "string", "enum": ["not-started", "partial", "complete"] },
    "verificationState": { "type": "string", "enum": ["not-verified", "single-source", "cross-checked", "hardware-verified"] },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "locator"],
      "properties": {
        "source": { "$ref": "#/$defs/id" },
        "locator": { "type": "string", "minLength": 1 }
      }
    },
    "evidenceList": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence" }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ch32-riscv-ug.github.io/ch32-device-data/schemas/structured-document.schema.json",
  "title": "CH32 structured datasheet excerpt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "conversion", "review", "pages", "tables"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document", "language", "sha256", "page_count", "selected_pages"],
      "properties": {
        "document": {"type": "string", "minLength": 1},
        "language": {"enum": ["zh", "en"]},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "page_count": {"type": "integer", "minimum": 1},
        "selected_pages": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 1}
        }
      }
    },
    "conversion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "engine_version", "coordinates", "table_settings"],
      "properties": {
        "engine": {"const": "pdfplumber"},
        "engine_version": {"type": "string", "minLength": 1},
        "coordinates": {"const": "PDF points, origin at top-left"},
        "table_settings": {"type": "object"}
      }
    },
    "review": {"$ref": "#/$defs/review"},
    "pages": {
      "type": "array",
      "items": {"$ref": "#/$defs/page"}
    },
    "tables": {
      "type": "array",
      "items": {"$ref": "#/$defs/table"}
    }
  },
  "$defs": {
    "bbox": {
      "type": "array",
      "prefixItems": [
        {"type": "number"}, {"type": "number"},
        {"type": "number"}, {"type": "number"}
      ],
      "items": false
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["unreviewed", "approved", "rejected"]},
        "note": {"type": "string"}
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "bbox"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "text": {"type": "string"},
        "bbox": {"$ref": "#/$defs/bbox"}
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "width", "height", "lines"],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "width": {"type": "number", "exclusiveMinimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0},
        "lines": {"type": "array", "items": {"$ref": "#/$defs/line"}}
      }
    },
    "caption": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["line_id", "source_number", "text"],
      "properties": {
        "line_id": {"type": "string", "minLength": 1},
        "source_number": {"type": "string", "pattern": "^\\d+(?:-\\d+)+$"},
        "text": {"type": "string"}
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "row_start", "row_end", "column_start", "column_end", "bbox", "text"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "row_start": {"type": "integer", "minimum": 0},
        "row_end": {"type": "integer", "minimum": 1},
        "column_start": {"type": "integer", "minimum": 0},
        "column_end": {"type": "integer", "minimum": 1},
        "bbox": {"$ref": "#/$defs/bbox"},
        "text": {"type": "string"}
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "logical_id", "page", "bbox", "caption", "continues_from_previous", "row_count", "column_count", "cells", "review"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "logical_id": {"type": "string", "minLength": 1},
        "page": {"type": "integer", "minimum": 1},
        "bbox": {"$ref": "#/$defs/bbox"},
        "caption": {"$ref": "#/$defs/caption"},
        "continues_from_previous": {"type": "boolean"},
        "row_count": {"type": "integer", "minimum": 1},
        "column_count": {"type": "integer", "minimum": 1},
        "cells": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cell"}},
        "review": {"$ref": "#/$defs/review"}
      }
    }
  }
}
